{
    "$schema": "https://opencode.ai/config.json",
    "enabled_providers": [
      "smallreterminator",
      "reterminator",
      "openrouter"
    ],
    "instructions": [
      "{env:HOME}/.config/opencode/karpathy-maxims.md",
    ],
    "default_agent": "plan",
    "plugin": ["opencode-smart-voice-notify@latest"],
    "share": "disabled",
    "model": "reterminator/default-think",
    "small_model": "smallreterminator/qw3.5-2b-nonthinking-Q5_K_S-default-ctx16k",
    "provider": {
        "reterminator": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "reterminator",
            "options": {
                "baseURL": "http://localhost:9292/v1/",
            },
            "models": {
                "default": {
                  "name": "Upstream default model",
                  "modalities": {
                    "input": ["text", "image"],
                    "output": ["text"]
                  },
                  "limit": {
                    "context": 196608,
                    "output": 65536,
                  },
                },
                "default-think": {
                  "name": "Upstream default thinking model",
                  "modalities": {
                    "input": ["text", "image"],
                    "output": ["text"]
                  },
                  "limit": {
                    "context": 196608,
                    "output": 65536,
                  },
                },
                "qw3.6-35b-multimodalcoding-Q6_K-default-ctx256k": {
                  "name": "Qwen3.6 multimodalcoding Q6_K (128k limit)",
                  "modalities": {
                    "input": ["text", "image"],
                    "output": ["text"]
                  },
                  "limit": {
                    "context": 131072,
                    "output": 65536
                  },
                },
            }
        },
        "smallreterminator": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "reterminator",
            "options": {
                "baseURL": "http://localhost:9292/small/v1/",
            },
            "models": {
                "qw3.5-4b-thinking-Q5_K_S-default-ctx256k":              { "name": "Qwen3.5 thinking 4B Q5_K_S 256" },
                "qw3.5-4b-nonthinking-Q5_K_S-default-ctx256k":           { "name": "Qwen3.5 nonthinking 4B Q5_K_S 256" },
            }
        },
    },
    "permission": {
      "external_directory": {
        // Agents regularly try to access their own worktree by absolute paths
        // (and should have no need to access other worktrees), so let's be
        // explicit.
        "~/worktrees/**": "deny",
        // In spite of my best intentions, models try to use /tmp all the time.
        // They can do other things.
        "/tmp/**": "deny",
      },
      "bash": {
        // I (still) do a bit of work that involves deploying through
        // ssh-backed deployment scripts. (The joys of self-hosting.) Models
        // sometimes get creative and start ssh'ing to the hosts themselves.
        //
        // This is sometimes a good thing. However, I want to be fairly
        // specific about what activities they should be able to undertake.
        // Thus, I've implemented (a root-owned—and self-checking that it's
        // still root-owned) s-agentic-wrap-command, which (through
        // permissions) OpenCode discovers and interrogates through --help etc.
        // This (safely) allows OpenCode to run select safe remote commands as
        // part of its troubleshooting.
        "ssh *": "deny",
        "s-agentic-wrap-command *": "allow",
      },
    },
    "skills": {
      // This refers to https://github.com/skrewz/s-ai-skills, which has been
      // factored out of my dotfiles:
      "paths": ["~/repos/s-ai-skills/human-accessible"],
    },
    "formatter": {
      "puppet-lint-dashdash-fix": {
        "command": ["puppet-lint", "--fix", "$FILE"],
        "extensions": [".pp"]
      }
    },
}
